# =============================================================================
# SMARTANK - variables para ejecutar con Docker Compose (local / desarrollo / QA)
# =============================================================================
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` ni secretos reales al repositorio.
# Para el despliegue en Dokploy NO se usa este archivo: ver .env.dokploy (variables por app) y DOKPLOY.md.
#
# Genera secretos largos y aleatorios, por ejemplo:   openssl rand -base64 48

# --- Base de datos local (contenedor SQL Server 2019) ------------------------
# Contrasena del usuario sa del contenedor (minimo 8 caracteres con mayusculas, minusculas, numeros y simbolos).
DB_SA_PASSWORD=
DB_NOMBRE=Smartank
DB_PUERTO=14333
# Esquema de las tablas. ddl.sql crea todo en dbo; si lo cambias, edita tambien ddl.sql.
DATABASE_ESQUEMA=dbo
# true = db-init tambien carga Database/seed_estaciones.sql (catalogo de EDS) la primera vez.
DB_CARGAR_ESTACIONES=true

# --- Aplicacion ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
# Secreto de firma de la sesion (JWT en cookie httpOnly) y su vigencia en horas.
JWT_SECRET=
JWT_EXPIRA_HORAS=12
# Costo de bcrypt para contrasenas nuevas (4 a 31).
SEGURIDAD_BCRYPT_ROUNDS=12
# false SOLO si se sirve por HTTP plano (local); en HTTPS debe ser true o el navegador descarta la cookie.
COOKIE_SECURE=false
# Secreto de firma del token de la bitacora del conductor (distinto del JWT_SECRET) y su vigencia en horas.
BITACORA_SECRET=
BITACORA_EXPIRA_HORAS=24
# Secreto compartido del header X-Service-Secret para la ingesta de telemetria.
SERVICIO_SECRETO=
# Origenes permitidos por CORS (separados por coma) y URL publica (para los enlaces de la bitacora).
CORS_ORIGENES=http://localhost:4200
APP_URL_PUBLICA=http://localhost:4200
API_PUERTO=8080
FRONTEND_PUERTO=4200

# --- SQL Server legado (SOLO LECTURA, opcionales) ------------------------------
# Sin estas cadenas el sistema arranca igual y las funciones que las usan responden 503 con un mensaje accionable.
# Maestros de flota, viajes, tanqueos, rutas y celulares de conductores:
FPSAP_CONNECTION=
# Cierre de viajes (data warehouse de operaciones). Si se deja vacia se reutilizan usuario y clave de FPSAP:
EBS_CONNECTION=

# --- Geotab (telemetria: ubicacion y nivel de tanque) ---------------------------
GEOTAB_DATABASE=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=
GEOTAB_SERVER=my.geotab.com

# --- WhatsApp (API HTTP) ----------------------------------------------------------
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_DELAY_MS=1200
# true redirige TODAS las ordenes a WHATSAPP_NUMERO_PRUEBA (solo pruebas; en Production el arranque falla si esta activo).
WHATSAPP_MODO_PRUEBA=false
WHATSAPP_NUMERO_PRUEBA=

# --- Estaciones de servicio (EDS) y precios -----------------------------------------
EDS_API_BASE_URL=
EDS_API_KEY=
EDS_WEBHOOK_SECRET=
PRECIOS_API_BASE_URL=
PRECIOS_API_KEY=

# --- Worker: sincronizaciones -------------------------------------------------------
# Intervalo del grupo frecuente (telemetria, tanqueos, viajes, rutas nuevas), en segundos.
SYNC_INTERVALO_SEGUNDOS=300
# true = el grupo diario tambien corre al arrancar el Worker.
SYNC_DIARIO_AL_INICIAR=true
# true = un viaje sin ruta Valhalla recibe una recta entre centros poblados DANE.
SYNC_RUTA_DANE_FALLBACK=false
# Fecha minima (inclusive) de lo que se sincroniza desde el legado.
SYNC_FOS_DESDE=2026-01-01
SYNC_TANQUEOS_DESDE=2026-01-01
SYNC_RUTAS_DESDE=2026-01-01
# Tolerancia de simplificacion de la polilinea de ruta, en metros (menor = mas detalle).
SYNC_RUTA_REDUCE_TOL_METROS=30
# Ventana (horas) para la ultima lectura de nivel de tanque y (dias) para derivar el rendimiento km/galon.
SYNC_VENTANA_NIVEL_HORAS=168
SYNC_RENDIMIENTO_VENTANA_DIAS=60
# Distancia maxima (km) para considerar una EDS "cercana a la ruta" en el precalculo de precios de referencia.
SYNC_RUTA_EDS_UMBRAL_KM=5

# --- Parametros de negocio (sobrescribibles) ----------------------------------------
# Margen de tolerancia de autonomia (0.02 = 2 %).
TOLERANCIA_AUTONOMIA_DEFAULT=0.02
# Faltante entre lo cargado y el aumento real de nivel que dispara la alerta de desviacion por carga.
UMBRAL_GALON_FANTASMA=0.05
UMBRAL_DESVIACION_CONSUMO=0.10
# Rendimiento (km/galon) cuando el vehiculo no tiene historico ni esperado.
RENDIMIENTO_DEFAULT_KM_GAL=8
DEFAULT_GALONES_AUTORIZACION=40
# Antiguedad maxima (horas) aceptada para la lectura de nivel de tanque al calcular autonomia.
NIVEL_MAX_ANTIGUEDAD_HORAS=168
