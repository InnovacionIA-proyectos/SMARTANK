# Secrets de GitHub Actions que necesitan los pipelines de .github/workflows/ (ci-cd-backend y ci-cd-frontend).
# No es un .env que la app lea: cada linea es <SECRET>=<de donde sale el valor> (Settings > Secrets and variables > Actions).
# Los nombres deben coincidir con los workflows; si un workflow agrega un secret, agregalo aqui. Nunca subas valores reales.

# --- CI del backend (.NET) - ci-cd-backend.yml ---
# Corre en un runner self-hosted: las BD son reales de la red corporativa. TEST_DB_CONNECTION es la BD de pruebas (nunca un
# contenedor efimero) y la suite completa corre contra ella. El esquema debe estar creado a mano con Database/ddl.sql.
TEST_DB_CONNECTION=<cadena de conexion a la BD de pruebas de SMARTANK (SQL Server 2019) con un login que lea y escriba filas, sin DDL>
# Esquema de las tablas en esa base (dbo si se ejecuto Database/ddl.sql sin cambios).
DATABASE_ESQUEMA=<dbo>
# Las dos siguientes son de solo lectura y opcionales: sin ellas las pruebas ejercitan el camino degradado, no la fuente real.
CONNECTIONSTRINGS_FPSAP=<cadena de conexion al SQL Server de flota, solo lectura>
CONNECTIONSTRINGS_EBS=<cadena de conexion al DW de operaciones (cierre de viajes), solo lectura>

# --- Despliegue (Dokploy) ---
# Webhook de cada servicio (Dokploy > servicio > Deployments > Webhook). Se dispara solo en push directo a main o DEPLOY, y tras
# pasar el build y las pruebas.
DOKPLOY_DEPLOY_WEBHOOK_URL_API=<URL del webhook de despliegue de la app smartank-api en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_WORKER=<URL del webhook de despliegue de la app smartank-worker en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_FRONTEND=<URL del webhook de despliegue de la app smartank-frontend en Dokploy>

# Las variables de runtime de cada servicio no son GitHub Secrets: van en el Environment de cada app en Dokploy (ver .env.dokploy).
