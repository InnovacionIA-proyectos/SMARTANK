# Variables de SMARTANK para Dokploy. Cada bloque es una app tipo "Application" (Dockerfile) distinta, no un docker-compose:
# los nombres son los reales que lee el proceso dentro del contenedor (no los alias del docker-compose.yml).
# Es una plantilla: nunca subas valores reales. Pegalas en la pestaña Environment de cada app.
# La base de datos NO es una app de Dokploy: es el SQL Server 2019 corporativo (el esquema se crea a mano con Database/ddl.sql).

# =============================================================================
# App "smartank-api"  (Build Path: backend | Dockerfile: src/Smartank.Api/Dockerfile | puerto interno 8080)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production
# BD principal de SMARTANK (SQL Server 2019). Obligatoria: sin ella la app no arranca.
ConnectionStrings__Smartank=Server=<host>,1433;Database=Smartank;User Id=<usuario-app>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;
# Esquema de las tablas. Debe coincidir con el usado al ejecutar Database/ddl.sql (por defecto dbo).
Database__Esquema=dbo
# Firma de la sesion (JWT en cookie httpOnly). Obligatoria. Genera un valor largo y aleatorio (openssl rand -base64 48).
Jwt__Secret=<secreto-largo-aleatorio>
Jwt__ExpiraHoras=12
# Costo de bcrypt para contrasenas nuevas (4 a 31; 12 es razonable).
Seguridad__BcryptRounds=12
# true en produccion (HTTPS). Si se sirve por HTTP plano el navegador descarta la cookie y el login "no entra" sin error.
Cookie__Secure=true
# Firma del token de la bitacora del conductor. Obligatoria. Distinta de Jwt__Secret.
Bitacora__Secret=<secreto-largo-aleatorio-distinto>
Bitacora__ExpiraHoras=24
# Secreto del header X-Service-Secret para la ingesta de telemetria. Obligatoria.
Servicio__Secreto=<secreto-de-servicio>
# Origenes permitidos por CORS. Obligatoria en Production. Como el frontend hace proxy de /api, es el dominio publico del frontend.
Cors__OrigenesPermitidos=https://<dominio-publico-smartank>
# URL publica del frontend (se usa para armar el enlace de la bitacora que recibe el conductor por WhatsApp).
App__UrlPublica=https://<dominio-publico-smartank>
# SQL Server legado, SOLO LECTURA (opcionales: si faltan, las funciones que las usan responden 503 con un mensaje accionable).
ConnectionStrings__Fpsap=Server=<host>,1433;Database=FPSAP;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__Ebs=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
# WhatsApp (API HTTP). Sin ApiUrl/ApiKey la orden se prepara pero no se envia.
Whatsapp__ApiUrl=<url-de-envio-incluye-la-instancia>
Whatsapp__ApiKey=<secreto>
Whatsapp__DelayMs=1200
# Pruebas: true redirige TODAS las ordenes a NumeroPrueba. En Production el arranque FALLA si esta en true. Dejar en false.
Whatsapp__ModoPrueba=false
Whatsapp__NumeroPrueba=
# Estaciones de servicio. Sin ApiBaseUrl la preautorizacion responde "simulado".
Eds__ApiBaseUrl=
Eds__ApiKey=
Eds__WebhookSecret=
# Fuentes publicas de precios (opcionales; estos son los valores por defecto). Precios__ApiBaseUrl/ApiKey estan reservadas y no tienen efecto.
Precios__ApiBaseUrl=
Precios__ApiKey=
Precios__TerpelUrl=https://www.terpel.com/api/map_points/eds
Precios__DistracomUrl=https://www.distracom.com.co
Precios__TimeoutSegundos=60
# Parametros de negocio (valores por defecto; sobrescribibles).
ParametrosNegocio__ToleranciaAutonomiaDefault=0.02
ParametrosNegocio__UmbralGalonFantasma=0.05
ParametrosNegocio__UmbralDesviacionConsumo=0.10
ParametrosNegocio__RendimientoDefaultKmGal=8
ParametrosNegocio__DefaultGalonesAutorizacion=40
ParametrosNegocio__NivelMaxAntiguedadHoras=168
# Administrador inicial: SOLO para ejecutar una vez el comando de creacion (ver DOKPLOY.md). Retirar despues.
Admin__Email=
Admin__Password=
Admin__Nombre=

# =============================================================================
# App "smartank-worker"  (Build Path: backend | Dockerfile: src/Smartank.Worker/Dockerfile | sin puerto)
# =============================================================================
DOTNET_ENVIRONMENT=Production
ConnectionStrings__Smartank=Server=<host>,1433;Database=Smartank;User Id=<usuario-app>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;
Database__Esquema=dbo
ConnectionStrings__Fpsap=Server=<host>,1433;Database=FPSAP;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__Ebs=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
# Geotab (telemetria). Obligatorias para el pull de telemetria y rendimiento.
Geotab__Database=<base-geotab>
Geotab__Username=<usuario>
Geotab__Password=<clave>
Geotab__Server=my.geotab.com
Geotab__TimeoutSegundos=60
Precios__ApiBaseUrl=
Precios__ApiKey=
Precios__TerpelUrl=https://www.terpel.com/api/map_points/eds
Precios__DistracomUrl=https://www.distracom.com.co
Precios__TimeoutSegundos=60
# Intervalo del grupo frecuente (telemetria, tanqueos, viajes, rutas nuevas) en segundos. El grupo diario corre 1 vez al dia.
Sync__IntervaloSegundos=300
# true = el grupo diario tambien corre al arrancar el Worker (si no, espera al siguiente dia calendario de Colombia).
Sync__DiarioAlIniciar=true
# true = un viaje sin ruta Valhalla recibe una recta entre centros poblados DANE (apagado por defecto).
Sync__RutaDaneFallback=false
Sync__FosDesde=2026-01-01
Sync__TanqueosDesde=2026-01-01
Sync__RutasDesde=2026-01-01
# Tolerancia de simplificacion de la polilinea (metros) y umbral de EDS cercana a la ruta (km).
Sync__RutaReduceTolMetros=30
Sync__RutaEdsUmbralKm=5
# Ventana del ultimo nivel de tanque (horas) y del calculo de rendimiento (dias).
Sync__VentanaNivelHoras=168
Sync__RendimientoVentanaDias=60
ParametrosNegocio__RendimientoDefaultKmGal=8

# =============================================================================
# App "smartank-frontend"  (Build Path: frontend | Dockerfile: Dockerfile | puerto interno 8080 | dominio publico)
# =============================================================================
# Hostname interno de la app "smartank-api" en Dokploy (pestaña Domains/Advanced de esa app) y su puerto.
# nginx reenvia /api y /health a este destino; el API no se expone a internet.
API_UPSTREAM=http://<host-smartank-api-en-dokploy>:8080
